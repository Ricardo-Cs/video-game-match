generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// A URL da conexão fica em prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

model Award {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  gameAward GameAward[]

  @@map("awards")
}

model Game {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  gameAward GameAward[]

  @@map("games")
}

model GameAward {
  gameId  Int @map("game_id")
  awardId Int @map("award_id")
  year    Int
  award   Award @relation(fields: [awardId], references: [id], onDelete: Cascade)
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, awardId])
  // Consulta por prêmio ("quais jogos ganharam X") não é coberta pela PK composta
  @@index([awardId])
  @@map("game_awards")
}
