generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// A URL da conexão fica em prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

model Award {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  gameAward GameAward[]

  @@map("awards")
}

// Jogo premiado. O vínculo com a IGDB é pelo id: nomes se repetem
// (há um "Hades" de 1995) e mudam de grafia ("Baldur's Gate III")
model Game {
  id        Int         @id @default(autoincrement())
  igdbId    Int         @unique @map("igdb_id")
  // Só para exibição e leitura do banco: a identidade do jogo é o igdbId
  name      String
  gameAward GameAward[]

  @@map("games")
}

model GameAward {
  gameId  Int @map("game_id")
  awardId Int @map("award_id")
  year    Int
  award   Award @relation(fields: [awardId], references: [id], onDelete: Cascade)
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, awardId])
  // Consulta por prêmio ("quais jogos ganharam X") não é coberta pela PK composta
  @@index([awardId])
  @@map("game_awards")
}

enum RoundStatus {
  IN_PROGRESS
  FINISHED
}

// Uma partida: a grade 3×3 sorteada e servida ao jogador.
// As categorias são guardadas como snapshot para que a validação dos palpites
// use exatamente o que foi sorteado, mesmo que o catálogo mude depois.
model Round {
  // uuid v7: não adivinhável (vai na URL) e ordenado por tempo (índice compacto)
  id          String      @id @default(uuid(7)) @db.Uuid
  // Semente do sorteio. Não refaz a grade sozinha (as contagens da IGDB mudam): a fonte é `categories`
  seed        String
  // Category[] na ordem [linha0, linha1, linha2, coluna0, coluna1, coluna2]
  categories  Json
  // Guardado por rodada para que mudar a regra não afete partidas em andamento
  maxAttempts Int         @map("max_attempts")
  status      RoundStatus @default(IN_PROGRESS)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  finishedAt  DateTime?   @map("finished_at")
  guesses     Guess[]

  @@index([createdAt])
  @@map("rounds")
}

// Cada tentativa numa célula, certa ou errada (serve também para a raridade das respostas).
// Índices únicos parciais na migration garantem, mesmo com requisições concorrentes:
// uma resposta certa por célula e o mesmo jogo certo em no máximo uma célula.
model Guess {
  id         String   @id @default(uuid(7)) @db.Uuid
  roundId    String   @map("round_id") @db.Uuid
  // 0..8, linha * 3 + coluna
  cell       Int      @db.SmallInt
  igdbGameId Int      @map("igdb_game_id")
  correct    Boolean
  // Snapshot do jogo no momento do palpite: a grade é exibida sem consultar a IGDB
  gameName   String   @map("game_name")
  coverUrl   String?  @map("cover_url")
  createdAt  DateTime @default(now()) @map("created_at")
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  // Raridade: "quantos acertaram a célula X com o jogo Y"
  @@index([igdbGameId])
  @@map("guesses")
}
